{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge-ecosystem-catalog",
  "main": "workers/ecosystem-catalog-worker.mjs",
  "compatibility_date": "2026-10-03",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "ECOSYSTEM_DB",
      "database_name": "forge-ecosystem-production",
      "database_id": "c54a26b7-bb94-418f-8220-5d8c04819f47",
      "migrations_dir": "ecosystem-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OEM_CATALOGS",
      "bucket_name": "forge-oem-catalogs-production"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "forge-oem-catalog-import",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "forge-oem-catalog-import-dlq"
      }
    ]
  }
}
