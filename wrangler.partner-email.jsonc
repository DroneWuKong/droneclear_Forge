{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge-partner-email",
  "main": "workers/partner-email-worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["accounts@uas-forge.com"] }],
  "d1_databases": [{
    "binding": "ECOSYSTEM_DB",
    "database_name": "forge-ecosystem-production",
    "database_id": "c54a26b7-bb94-418f-8220-5d8c04819f47",
    "migrations_dir": "ecosystem-migrations"
  }],
  "triggers": { "crons": ["* * * * *"] }
}
