{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge-model-budget",
  "main": "workers/model-budget.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "MODEL_BUDGET", "class_name": "ModelBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ModelBudget"] }]
}
