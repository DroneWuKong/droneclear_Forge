# Cloudflare Pages _headers

# Site-wide baseline. Camera remains self because selected Forge workflows use
# getUserMedia. No includeSubDomains on HSTS until all subdomains share policy.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

# HTML and route indexes always revalidate after deployment.
/*.html
  Cache-Control: no-cache, must-revalidate

/*/
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Versioned static assets can be immutable.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public status metadata changes independently of application assets.
/static/dataset_catalog.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store

/dataset_catalog.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store

# Private gated area — never cache or index.
/private/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
