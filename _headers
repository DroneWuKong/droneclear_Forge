# Cloudflare Pages _headers

# Site-wide security headers. Camera stays self — the guide/audit step-photo
# capture uses getUserMedia. No includeSubDomains on HSTS: subdomain coverage
# (www, dash) isn't uniform yet.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

# HTML pages: always revalidate (fixes stale JS after deploys)
/*.html
  Cache-Control: no-cache, must-revalidate

/*/
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Static assets: cache 1 year (they have ?v= busters)
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Private gated area — never cache, never index
/private/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
