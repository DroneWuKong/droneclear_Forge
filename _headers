# Cloudflare Pages _headers

# Site-wide baseline. Camera remains self because selected Forge workflows use
# getUserMedia. No includeSubDomains on HSTS until all subdomains share policy.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

# HTML and route indexes always revalidate after deployment.
/*.html
  Cache-Control: no-cache, must-revalidate

/*/
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Versioned static assets can be immutable.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# JSON is replaced by each publication and has no content-hashed filename.
# Keep immutable caching for versioned JS/CSS only.
/static/*.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store

# Public status metadata changes independently of application assets.
/static/dataset_catalog.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store

/dataset_catalog.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store

# The gzip file format is separate from HTTP content encoding.
/research_index.json
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

/static/research_index.json
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

/research_index.json.gzip
  Content-Type: application/gzip
  Content-Encoding: identity
  Cache-Control: no-cache, must-revalidate

/research_index.metadata.json
  Cache-Control: no-cache, must-revalidate

# Public model metadata is regenerated with each pinned upstream release.
/models/catalog.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store

# Model filenames are stable, so revalidate instead of treating them as
# content-addressed immutable assets. SHA256 values are published in catalog.json.
/models/files/*
  Cache-Control: public, max-age=3600, must-revalidate

/system-tests/*
  Cache-Control: no-cache, must-revalidate

# Private gated area — never cache or index.
/private/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
